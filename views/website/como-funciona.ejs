<!--views\website\funcion.ejs-->
<% layout("layouts/website") %>

<!-- =========================================================
     HERO
========================================================= -->

<section class="bg-dark text-white py-5">

  <div class="container py-5">

    <div class="row align-items-center g-5">

      <div class="col-lg-7">

        <span class="badge bg-success px-3 py-2 mb-3">
          <i class="bi bi-lightning-fill me-2"></i>
          CÓMO FUNCIONA
        </span>

        <h1 class="display-4 fw-bold mb-4">
          Todo lo que necesitas,
          <span class="text-success">
            en un solo lugar.
          </span>
        </h1>

        <p class="lead text-light mb-4">
          PlayerStats facilita la consulta, búsqueda y
          organización de información mediante una
          plataforma sencilla, rápida y fácil de utilizar.
        </p>

        <div class="d-flex flex-wrap gap-2">

          <a
            href="/players"
            class="btn btn-success btn-lg px-4"
          >

            <i class="bi bi-search me-2"></i>
            Explorar jugadores

          </a>

          <a
            href="#pasos"
            class="btn btn-outline-light btn-lg px-4"
          >

            Ver cómo funciona

          </a>

        </div>

      </div>


      <div class="col-lg-5 text-center">

        <div
          class="bg-success bg-opacity-10
                 rounded-4 p-5"
        >

          <i
            class="bi bi-diagram-3-fill text-success"
            style="font-size:9rem;"
          ></i>

        </div>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     INTRODUCCIÓN
========================================================= -->

<section class="py-5">

  <div class="container">

    <div class="row justify-content-center">

      <div class="col-lg-9 text-center">

        <span class="text-success fw-bold text-uppercase">
          Plataforma PlayerStats
        </span>

        <h2 class="fw-bold mt-2 mb-4">
          Diseñada para encontrar información rápidamente
        </h2>

        <p class="text-muted lead">
          No necesitas recorrer cientos de páginas para
          encontrar lo que buscas. Utiliza nuestras
          herramientas de búsqueda y filtros para acceder
          rápidamente a la información disponible.
        </p>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     PASOS
========================================================= -->

<section
  id="pasos"
  class="bg-light py-5"
>

  <div class="container">

    <div class="text-center mb-5">

      <span class="text-success fw-bold text-uppercase">
        Paso a paso
      </span>

      <h2 class="fw-bold mt-2">
        ¿Cómo funciona PlayerStats?
      </h2>

      <p class="text-muted">
        Utilizar la plataforma es muy sencillo.
      </p>

    </div>


    <div class="row g-4">


      <!-- PASO 1 -->

      <div class="col-12 col-md-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body p-4">

            <div class="d-flex
                        justify-content-between
                        align-items-center">

              <div
                class="bg-success text-white
                       rounded-circle
                       d-flex align-items-center
                       justify-content-center"
                style="width:55px;height:55px;"
              >

                <i class="bi bi-search fs-4"></i>

              </div>

              <span
                class="display-6 fw-bold
                       text-success opacity-25"
              >
                01
              </span>

            </div>

            <h4 class="fw-bold mt-4">
              Busca
            </h4>

            <p class="text-muted mb-0">
              Introduce el nombre del jugador,
              equipo o información que deseas encontrar.
            </p>

          </div>

        </div>

      </div>


      <!-- PASO 2 -->

      <div class="col-12 col-md-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body p-4">

            <div class="d-flex
                        justify-content-between
                        align-items-center">

              <div
                class="bg-success text-white
                       rounded-circle
                       d-flex align-items-center
                       justify-content-center"
                style="width:55px;height:55px;"
              >

                <i class="bi bi-funnel-fill fs-4"></i>

              </div>

              <span
                class="display-6 fw-bold
                       text-success opacity-25"
              >
                02
              </span>

            </div>

            <h4 class="fw-bold mt-4">
              Filtra
            </h4>

            <p class="text-muted mb-0">
              Utiliza diferentes filtros para
              reducir los resultados y encontrar
              exactamente lo que necesitas.
            </p>

          </div>

        </div>

      </div>


      <!-- PASO 3 -->

      <div class="col-12 col-md-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body p-4">

            <div class="d-flex
                        justify-content-between
                        align-items-center">

              <div
                class="bg-success text-white
                       rounded-circle
                       d-flex align-items-center
                       justify-content-center"
                style="width:55px;height:55px;"
              >

                <i class="bi bi-person-vcard-fill fs-4"></i>

              </div>

              <span
                class="display-6 fw-bold
                       text-success opacity-25"
              >
                03
              </span>

            </div>

            <h4 class="fw-bold mt-4">
              Consulta
            </h4>

            <p class="text-muted mb-0">
              Selecciona un resultado para consultar
              toda la información disponible.
            </p>

          </div>

        </div>

      </div>


      <!-- PASO 4 -->

      <div class="col-12 col-md-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body p-4">

            <div class="d-flex
                        justify-content-between
                        align-items-center">

              <div
                class="bg-success text-white
                       rounded-circle
                       d-flex align-items-center
                       justify-content-center"
                style="width:55px;height:55px;"
              >

                <i class="bi bi-bar-chart-fill fs-4"></i>

              </div>

              <span
                class="display-6 fw-bold
                       text-success opacity-25"
              >
                04
              </span>

            </div>

            <h4 class="fw-bold mt-4">
              Analiza
            </h4>

            <p class="text-muted mb-0">
              Revisa estadísticas, características
              y datos relacionados.
            </p>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     JUGADORES
========================================================= -->

<section class="py-5">

  <div class="container">

    <div class="row align-items-center g-5">

      <div class="col-lg-6">

        <div
          class="bg-dark rounded-4
                 p-5 text-center"
        >

          <i
            class="bi bi-people-fill text-success"
            style="font-size:8rem;"
          ></i>

        </div>

      </div>


      <div class="col-lg-6">

        <span class="badge bg-success mb-3">
          01 · JUGADORES
        </span>

        <h2 class="display-6 fw-bold mb-4">
          Encuentra al jugador
          que estás buscando.
        </h2>

        <p class="text-muted lead">
          Accede a una base de datos organizada
          para consultar diferentes características
          de los jugadores.
        </p>

        <div class="mt-4">


          <div class="d-flex mb-3">

            <div class="text-success me-3">
              <i class="bi bi-check-circle-fill fs-5"></i>
            </div>

            <div>
              <h6 class="fw-bold mb-1">
                Búsqueda por nombre
              </h6>

              <p class="text-muted small mb-0">
                Encuentra rápidamente jugadores
                mediante su nombre.
              </p>
            </div>

          </div>


          <div class="d-flex mb-3">

            <div class="text-success me-3">
              <i class="bi bi-check-circle-fill fs-5"></i>
            </div>

            <div>
              <h6 class="fw-bold mb-1">
                Filtros avanzados
              </h6>

              <p class="text-muted small mb-0">
                Filtra por posición, nación,
                liga y equipo.
              </p>
            </div>

          </div>


          <div class="d-flex">

            <div class="text-success me-3">
              <i class="bi bi-check-circle-fill fs-5"></i>
            </div>

            <div>
              <h6 class="fw-bold mb-1">
                Estadísticas
              </h6>

              <p class="text-muted small mb-0">
                Consulta las principales características
                de cada jugador.
              </p>
            </div>

          </div>

        </div>

        <a
          href="/players"
          class="btn btn-success mt-4 px-4"
        >

          Explorar jugadores
          <i class="bi bi-arrow-right ms-2"></i>

        </a>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     FILTROS
========================================================= -->

<section class="bg-light py-5">

  <div class="container">

    <div class="row align-items-center g-5">


      <div class="col-lg-6 order-lg-2">

        <div
          class="card border-0 shadow-sm"
        >

          <div class="card-body p-4">

            <div class="d-flex
                        align-items-center
                        mb-4">

              <div
                class="bg-success bg-opacity-10
                       text-success rounded-3
                       d-flex align-items-center
                       justify-content-center me-3"
                style="width:60px;height:60px;"
              >

                <i class="bi bi-funnel-fill fs-3"></i>

              </div>

              <div>

                <h5 class="fw-bold mb-1">
                  Filtros inteligentes
                </h5>

                <p class="text-muted small mb-0">
                  Encuentra resultados más precisos.
                </p>

              </div>

            </div>


            <div class="mb-3">

              <label class="form-label fw-semibold">
                Posición
              </label>

              <select class="form-select">

                <option>
                  Todas las posiciones
                </option>

                <option>
                  Portero
                </option>

                <option>
                  Defensa
                </option>

                <option>
                  Mediocampista
                </option>

                <option>
                  Delantero
                </option>

              </select>

            </div>


            <div class="mb-3">

              <label class="form-label fw-semibold">
                Liga
              </label>

              <select class="form-select">

                <option>
                  Todas las ligas
                </option>

                <option>
                  Premier League
                </option>

                <option>
                  La Liga
                </option>

                <option>
                  Serie A
                </option>

                <option>
                  Bundesliga
                </option>

              </select>

            </div>


            <div class="mb-4">

              <label class="form-label fw-semibold">
                Nación
              </label>

              <select class="form-select">

                <option>
                  Todas las naciones
                </option>

                <option>
                  Argentina
                </option>

                <option>
                  Brasil
                </option>

                <option>
                  Francia
                </option>

                <option>
                  España
                </option>

              </select>

            </div>


            <button
              class="btn btn-success w-100"
              type="button"
            >

              <i class="bi bi-search me-2"></i>
              Aplicar filtros

            </button>

          </div>

        </div>

      </div>


      <div class="col-lg-6 order-lg-1">

        <span class="badge bg-success mb-3">
          02 · FILTROS
        </span>

        <h2 class="display-6 fw-bold mb-4">
          Reduce los resultados
          en segundos.
        </h2>

        <p class="text-muted lead">
          Cuando buscas un jugador específico,
          puedes utilizar diferentes criterios
          para obtener resultados más precisos.
        </p>

        <p class="text-muted">
          Combina varios filtros para encontrar
          exactamente el perfil que necesitas.
        </p>

        <a
          href="/players"
          class="btn btn-outline-success mt-3"
        >

          Probar filtros
          <i class="bi bi-arrow-right ms-2"></i>

        </a>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     INFORMACIÓN ORGANIZADA
========================================================= -->

<section class="py-5">

  <div class="container">

    <div class="text-center mb-5">

      <span class="text-success fw-bold text-uppercase">
        Información organizada
      </span>

      <h2 class="fw-bold mt-2">
        Todo conectado
      </h2>

      <p class="text-muted">
        PlayerStats organiza la información
        en diferentes categorías.
      </p>

    </div>


    <div class="row g-4">


      <!-- Jugadores -->

      <div class="col-12 col-md-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body p-4 text-center">

            <div
              class="bg-success bg-opacity-10
                     text-success rounded-circle
                     d-inline-flex
                     align-items-center
                     justify-content-center"
              style="width:70px;height:70px;"
            >

              <i class="bi bi-people-fill fs-2"></i>

            </div>

            <h5 class="fw-bold mt-3">
              Jugadores
            </h5>

            <p class="text-muted small mb-0">
              Consulta información y estadísticas
              de diferentes jugadores.
            </p>

          </div>

        </div>

      </div>


      <!-- Equipos -->

      <div class="col-12 col-md-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body p-4 text-center">

            <div
              class="bg-primary bg-opacity-10
                     text-primary rounded-circle
                     d-inline-flex
                     align-items-center
                     justify-content-center"
              style="width:70px;height:70px;"
            >

              <i class="bi bi-shield-fill fs-2"></i>

            </div>

            <h5 class="fw-bold mt-3">
              Equipos
            </h5>

            <p class="text-muted small mb-0">
              Explora los equipos asociados
              a los jugadores.
            </p>

          </div>

        </div>

      </div>


      <!-- Ligas -->

      <div class="col-12 col-md-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body p-4 text-center">

            <div
              class="bg-warning bg-opacity-10
                     text-warning rounded-circle
                     d-inline-flex
                     align-items-center
                     justify-content-center"
              style="width:70px;height:70px;"
            >

              <i class="bi bi-trophy-fill fs-2"></i>

            </div>

            <h5 class="fw-bold mt-3">
              Ligas
            </h5>

            <p class="text-muted small mb-0">
              Consulta información relacionada
              con diferentes competiciones.
            </p>

          </div>

        </div>

      </div>


      <!-- Naciones -->

      <div class="col-12 col-md-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body p-4 text-center">

            <div
              class="bg-danger bg-opacity-10
                     text-danger rounded-circle
                     d-inline-flex
                     align-items-center
                     justify-content-center"
              style="width:70px;height:70px;"
            >

              <i class="bi bi-globe-americas fs-2"></i>

            </div>

            <h5 class="fw-bold mt-3">
              Naciones
            </h5>

            <p class="text-muted small mb-0">
              Descubre jugadores según
              su nacionalidad.
            </p>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     VENTAJAS
========================================================= -->

<section class="bg-dark text-white py-5">

  <div class="container">

    <div class="row align-items-center g-5">


      <div class="col-lg-6">

        <span class="badge bg-success mb-3">
          ¿POR QUÉ UTILIZARLO?
        </span>

        <h2 class="display-6 fw-bold mb-4">
          Una experiencia
          simple y rápida.
        </h2>

        <p class="text-secondary lead">
          PlayerStats está pensado para que puedas
          encontrar información sin complicaciones.
        </p>

      </div>


      <div class="col-lg-6">

        <div class="row g-3">


          <div class="col-6">

            <div
              class="card bg-white bg-opacity-10
                     border-secondary h-100"
            >

              <div class="card-body p-4">

                <i
                  class="bi bi-lightning-fill
                         text-success fs-1"
                ></i>

                <h5 class="mt-3">
                  Rápido
                </h5>

                <p class="text-secondary small mb-0">
                  Encuentra información rápidamente.
                </p>

              </div>

            </div>

          </div>


          <div class="col-6">

            <div
              class="card bg-white bg-opacity-10
                     border-secondary h-100"
            >

              <div class="card-body p-4">

                <i
                  class="bi bi-funnel-fill
                         text-success fs-1"
                ></i>

                <h5 class="mt-3">
                  Flexible
                </h5>

                <p class="text-secondary small mb-0">
                  Utiliza diferentes filtros.
                </p>

              </div>

            </div>

          </div>


          <div class="col-6">

            <div
              class="card bg-white bg-opacity-10
                     border-secondary h-100"
            >

              <div class="card-body p-4">

                <i
                  class="bi bi-database-fill
                         text-success fs-1"
                ></i>

                <h5 class="mt-3">
                  Organizado
                </h5>

                <p class="text-secondary small mb-0">
                  Información estructurada.
                </p>

              </div>

            </div>

          </div>


          <div class="col-6">

            <div
              class="card bg-white bg-opacity-10
                     border-secondary h-100"
            >

              <div class="card-body p-4">

                <i
                  class="bi bi-phone-fill
                         text-success fs-1"
                ></i>

                <h5 class="mt-3">
                  Adaptable
                </h5>

                <p class="text-secondary small mb-0">
                  Diseño adaptado a diferentes dispositivos.
                </p>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     CTA FINAL
========================================================= -->

<section class="py-5">

  <div class="container">

    <div
      class="bg-success rounded-4
             p-4 p-md-5
             text-center text-white
             shadow"
    >

      <i class="bi bi-rocket-takeoff-fill fs-1"></i>

      <h2 class="fw-bold mt-3">
        ¿Listo para comenzar?
      </h2>

      <p class="lead mb-4">
        Explora PlayerStats y descubre
        toda la información disponible.
      </p>

      <div class="d-flex
                  flex-wrap
                  justify-content-center
                  gap-2">

        <a
          href="/players"
          class="btn btn-light btn-lg px-4"
        >

          <i class="bi bi-search me-2"></i>
          Explorar jugadores

        </a>

        <a
          href="/"
          class="btn btn-outline-light btn-lg px-4"
        >

          Volver al inicio

        </a>

      </div>

    </div>

  </div>

</section>
