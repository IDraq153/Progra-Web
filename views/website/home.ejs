<!-- views/website/home.ejs -->
<% layout("layouts/website") %>

<section class="bg-dark text-white">

  <div id="heroCarousel"
       class="carousel slide carousel-fade"
       data-bs-ride="carousel">

    <!-- Indicadores -->
    <div class="carousel-indicators">

      <button
        type="button"
        data-bs-target="#heroCarousel"
        data-bs-slide-to="0"
        class="active"
        aria-current="true"
        aria-label="Slide 1">
      </button>

      <button
        type="button"
        data-bs-target="#heroCarousel"
        data-bs-slide-to="1"
        aria-label="Slide 2">
      </button>

      <button
        type="button"
        data-bs-target="#heroCarousel"
        data-bs-slide-to="2"
        aria-label="Slide 3">
      </button>

    </div>


    <!-- Slides -->
    <div class="carousel-inner">


      <!-- SLIDE 1 -->
      <div class="carousel-item active">

        <div
          class="container-fluid"
          style="
            min-height: 600px;
            background:
              linear-gradient(
                90deg,
                rgba(0,0,0,.90),
                rgba(0,0,0,.55),
                rgba(0,0,0,.25)
              ),
              url('/assets/img/slider-1.jpg')
              center/cover;
          ">

          <div
            class="container d-flex align-items-center"
            style="min-height: 600px;">

            <div class="row">

              <div class="col-lg-7">

                <span class="badge bg-success mb-3 px-3 py-2">
                  FIFA / EA FC PLAYER DATABASE
                </span>

                <h1 class="display-3 fw-bold mb-4">
                  Descubre el mundo de
                  <span class="text-success">
                    PlayerStats
                  </span>
                </h1>

                <p class="lead text-light mb-4">
                  Explora una completa base de datos de jugadores,
                  equipos, ligas, posiciones y estadísticas.
                </p>

                <div class="d-flex flex-wrap gap-2">

                  <a
                    href="/players"
                    class="btn btn-success btn-lg px-4">

                    <i class="bi bi-people me-2"></i>
                    Explorar jugadores

                  </a>

                  <a
                    href="#about"
                    class="btn btn-outline-light btn-lg px-4">

                    Conocer más

                  </a>

                </div>

              </div>

            </div>

          </div>

        </div>

      </div>


      <!-- SLIDE 2 -->
      <div class="carousel-item">

        <div
          class="container-fluid"
          style="
            min-height: 600px;
            background:
              linear-gradient(
                90deg,
                rgba(0,0,0,.90),
                rgba(0,0,0,.55),
                rgba(0,0,0,.25)
              ),
              url('/assets/img/slider-2.jpg')
              center/cover;
          ">

          <div
            class="container d-flex align-items-center"
            style="min-height: 600px;">

            <div class="row w-100">

              <div class="col-lg-7">

                <span class="badge bg-success mb-3 px-3 py-2">
                  PLAYER STATISTICS
                </span>

                <h2 class="display-4 fw-bold mb-4">
                  Analiza cada
                  <span class="text-success">
                    estadística
                  </span>
                </h2>

                <p class="lead mb-4">
                  Consulta velocidad, tiro, pase, regate,
                  defensa, físico y valoración general.
                </p>

                <a
                  href="/players"
                  class="btn btn-success btn-lg px-4">

                  Ver estadísticas

                </a>

              </div>

            </div>

          </div>

        </div>

      </div>


      <!-- SLIDE 3 -->
      <div class="carousel-item">

        <div
          class="container-fluid"
          style="
            min-height: 600px;
            background:
              linear-gradient(
                90deg,
                rgba(0,0,0,.90),
                rgba(0,0,0,.55),
                rgba(0,0,0,.25)
              ),
              url('/assets/img/slider-3.jpg')
              center/cover;
          ">

          <div
            class="container d-flex align-items-center"
            style="min-height: 600px;">

            <div class="row w-100">

              <div class="col-lg-7">

                <span class="badge bg-success mb-3 px-3 py-2">
                  SMART FILTERS
                </span>

                <h2 class="display-4 fw-bold mb-4">
                  Encuentra al jugador
                  <span class="text-success">
                    perfecto
                  </span>
                </h2>

                <p class="lead mb-4">
                  Filtra jugadores por posición, nación,
                  liga, equipo, pie y estilo de juego.
                </p>

                <a
                  href="/players"
                  class="btn btn-success btn-lg px-4">

                  <i class="bi bi-search me-2"></i>
                  Buscar jugadores

                </a>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>


    <!-- Controles -->
    <button
      class="carousel-control-prev"
      type="button"
      data-bs-target="#heroCarousel"
      data-bs-slide="prev">

      <span class="carousel-control-prev-icon"></span>

      <span class="visually-hidden">
        Anterior
      </span>

    </button>

    <button
      class="carousel-control-next"
      type="button"
      data-bs-target="#heroCarousel"
      data-bs-slide="next">

      <span class="carousel-control-next-icon"></span>

      <span class="visually-hidden">
        Siguiente
      </span>

    </button>

  </div>

</section>


<!-- =========================================================
     BUSCADOR RÁPIDO
========================================================= -->

<section class="bg-light py-5">

  <div class="container">

    <div class="text-center mb-4">

      <span class="text-success fw-bold text-uppercase">
        Explora la base de datos
      </span>

      <h2 class="fw-bold mt-2">
        Encuentra tu jugador
      </h2>

      <p class="text-muted">
        Utiliza los filtros para encontrar exactamente
        el jugador que estás buscando.
      </p>

    </div>


    <div class="card border-0 shadow-sm">

      <div class="card-body p-4">

        <form
          action="/players"
          method="GET">

          <div class="row g-3">

            <!-- Nombre -->
            <div class="col-12 col-lg-4">

              <label class="form-label fw-semibold">
                Jugador
              </label>

              <div class="input-group">

                <span class="input-group-text bg-white">
                  <i class="bi bi-search"></i>
                </span>

                <input
                  type="text"
                  class="form-control"
                  name="search"
                  placeholder="Ej. Messi, Mbappé, Haaland...">

              </div>

            </div>


            <!-- Posición -->
            <div class="col-12 col-md-4 col-lg-2">

              <label class="form-label fw-semibold">
                Posición
              </label>

              <select
                name="position"
                class="form-select">

                <option value="">
                  Todas
                </option>

                <option value="GK">
                  GK
                </option>

                <option value="CB">
                  CB
                </option>

                <option value="CM">
                  CM
                </option>

                <option value="CAM">
                  CAM
                </option>

                <option value="LW">
                  LW
                </option>

                <option value="RW">
                  RW
                </option>

                <option value="ST">
                  ST
                </option>

              </select>

            </div>


            <!-- Nación -->
            <div class="col-12 col-md-4 col-lg-2">

              <label class="form-label fw-semibold">
                Nación
              </label>

              <select
                name="nation"
                class="form-select">

                <option value="">
                  Todas
                </option>

                <option value="Argentina">
                  Argentina
                </option>

                <option value="Brazil">
                  Brasil
                </option>

                <option value="France">
                  Francia
                </option>

                <option value="Spain">
                  España
                </option>

              </select>

            </div>


            <!-- Liga -->
            <div class="col-12 col-md-4 col-lg-2">

              <label class="form-label fw-semibold">
                Liga
              </label>

              <select
                name="league"
                class="form-select">

                <option value="">
                  Todas
                </option>

                <option value="Premier League">
                  Premier League
                </option>

                <option value="La Liga">
                  La Liga
                </option>

                <option value="Serie A">
                  Serie A
                </option>

                <option value="Bundesliga">
                  Bundesliga
                </option>

              </select>

            </div>


            <!-- Botón -->
            <div class="col-12 col-lg-2 d-flex align-items-end">

              <button
                type="submit"
                class="btn btn-success w-100">

                <i class="bi bi-search me-2"></i>
                Buscar

              </button>

            </div>

          </div>

        </form>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     ESTADÍSTICAS GENERALES
========================================================= -->

<section class="py-5">

  <div class="container">

    <div class="text-center mb-5">

      <span class="text-success fw-bold">
        PLAYERSTATS
      </span>

      <h2 class="fw-bold mt-2">
        Nuestra base de datos
      </h2>

    </div>


    <div class="row g-4">


      <!-- Jugadores -->
      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-success bg-opacity-10
                     text-success rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-3"
              style="width:70px;height:70px;">

              <i class="bi bi-people fs-2"></i>

            </div>

            <h3 class="fw-bold mb-1">
              <%= typeof playerCount !== 'undefined' ? playerCount : '12K+' %>
            </h3>

            <p class="text-muted mb-0">
              Jugadores
            </p>

          </div>

        </div>

      </div>


      <!-- Equipos -->
      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-primary bg-opacity-10
                     text-primary rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-3"
              style="width:70px;height:70px;">

              <i class="bi bi-shield fs-2"></i>

            </div>

            <h3 class="fw-bold mb-1">
              <%= typeof teamCount !== 'undefined' ? teamCount : '500+' %>
            </h3>

            <p class="text-muted mb-0">
              Equipos
            </p>

          </div>

        </div>

      </div>


      <!-- Ligas -->
      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-warning bg-opacity-10
                     text-warning rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-3"
              style="width:70px;height:70px;">

              <i class="bi bi-trophy fs-2"></i>

            </div>

            <h3 class="fw-bold mb-1">
              <%= typeof leagueCount !== 'undefined' ? leagueCount : '40+' %>
            </h3>

            <p class="text-muted mb-0">
              Ligas
            </p>

          </div>

        </div>

      </div>


      <!-- Naciones -->
      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-danger bg-opacity-10
                     text-danger rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-3"
              style="width:70px;height:70px;">

              <i class="bi bi-globe-americas fs-2"></i>

            </div>

            <h3 class="fw-bold mb-1">
              <%= typeof nationCount !== 'undefined' ? nationCount : '200+' %>
            </h3>

            <p class="text-muted mb-0">
              Naciones
            </p>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     SOBRE LA APLICACIÓN
========================================================= -->

<section
  id="about"
  class="bg-dark text-white py-5">

  <div class="container">

    <div class="row align-items-center g-5">

      <div class="col-lg-6">

        <span class="badge bg-success mb-3">
          SOBRE PLAYERSTATS
        </span>

        <h2 class="display-6 fw-bold mb-4">
          Todo lo que necesitas
          para explorar jugadores.
        </h2>

        <p class="text-secondary lead">
          PlayerStats es una plataforma diseñada para
          consultar y gestionar información relacionada
          con jugadores de FIFA / EA FC.
        </p>

        <p class="text-secondary">
          La información está organizada mediante jugadores,
          equipos, ligas, naciones, posiciones, pies y
          estilos de juego.
        </p>

        <a
          href="/players"
          class="btn btn-success mt-3">

          Explorar base de datos

        </a>

      </div>


      <div class="col-lg-6">

        <div class="row g-3">

          <div class="col-6">

            <div class="card bg-secondary bg-opacity-10
                        border-secondary h-100">

              <div class="card-body p-4">

                <i class="bi bi-bar-chart-fill
                          text-success fs-1"></i>

                <h5 class="mt-3">
                  Estadísticas
                </h5>

                <p class="text-secondary small mb-0">
                  Consulta las principales estadísticas
                  de cada jugador.
                </p>

              </div>

            </div>

          </div>


          <div class="col-6">

            <div class="card bg-secondary bg-opacity-10
                        border-secondary h-100">

              <div class="card-body p-4">

                <i class="bi bi-funnel-fill
                          text-success fs-1"></i>

                <h5 class="mt-3">
                  Filtros
                </h5>

                <p class="text-secondary small mb-0">
                  Encuentra jugadores utilizando
                  múltiples filtros.
                </p>

              </div>

            </div>

          </div>


          <div class="col-6">

            <div class="card bg-secondary bg-opacity-10
                        border-secondary h-100">

              <div class="card-body p-4">

                <i class="bi bi-database-fill
                          text-success fs-1"></i>

                <h5 class="mt-3">
                  Base de datos
                </h5>

                <p class="text-secondary small mb-0">
                  Información organizada y relacionada.
                </p>

              </div>

            </div>

          </div>


          <div class="col-6">

            <div class="card bg-secondary bg-opacity-10
                        border-secondary h-100">

              <div class="card-body p-4">

                <i class="bi bi-lightning-fill
                          text-success fs-1"></i>

                <h5 class="mt-3">
                  Rápido
                </h5>

                <p class="text-secondary small mb-0">
                  Busca y encuentra jugadores
                  rápidamente.
                </p>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     CTA FINAL
========================================================= -->

<section class="py-5">

  <div class="container">

    <div
      class="bg-success rounded-4 p-5 text-center text-white">

      <i class="bi bi-shield-fill-check fs-1"></i>

      <h2 class="fw-bold mt-3">
        ¿Listo para explorar?
      </h2>

      <p class="lead mb-4">
        Descubre jugadores, estadísticas,
        equipos y mucho más.
      </p>

      <a
        href="/players"
        class="btn btn-light btn-lg px-5">

        <i class="bi bi-search me-2"></i>
        Explorar jugadores

      </a>

    </div>

  </div>

</section>