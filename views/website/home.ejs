<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>GTA VI — Vice City</title>

  <!-- Bootstrap 5 -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap"
    rel="stylesheet"
  >

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #050505;
      color: white;
      font-family: 'Montserrat', sans-serif;
    }

    /* NAVBAR */
    .navbar {
      background: rgba(0, 0, 0, .75);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,.1);
    }

    .navbar-brand {
      font-size: 1.8rem;
      font-weight: 900;
      letter-spacing: -2px;
      color: #fff !important;
    }

    .navbar-brand span {
      color: #ff4da6;
    }

    .nav-link {
      color: #ddd !important;
      font-weight: 600;
      margin-left: 20px;
      transition: .3s;
    }

    .nav-link:hover {
      color: #ff4da6 !important;
    }

    /* HERO */
    .hero {
      min-height: 100vh;
      position: relative;
      display: flex;
      align-items: center;
      overflow: hidden;

      background:
        linear-gradient(
          90deg,
          rgba(0,0,0,.9) 0%,
          rgba(0,0,0,.6) 45%,
          rgba(0,0,0,.15) 100%
        ),
        url("https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=2000&q=80")
        center/cover;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(0deg, #050505 0%, transparent 20%),
        linear-gradient(180deg, rgba(0,0,0,.4), transparent);
      pointer-events: none;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 700px;
    }

    .eyebrow {
      color: #ff4da6;
      font-weight: 800;
      letter-spacing: 5px;
      text-transform: uppercase;
      margin-bottom: 15px;
    }

    .hero h1 {
      font-size: clamp(4rem, 10vw, 8rem);
      line-height: .8;
      font-weight: 900;
      letter-spacing: -7px;
      text-transform: uppercase;
      margin-bottom: 30px;
      text-shadow: 5px 5px 0 rgba(255, 77, 166, .25);
    }

    .hero h1 span {
      color: #ff4da6;
    }

    .hero p {
      font-size: 1.1rem;
      color: #ddd;
      line-height: 1.7;
      max-width: 580px;
    }

    .btn-gta {
      background: #ff4da6;
      border: none;
      color: white;
      font-weight: 800;
      padding: 15px 30px;
      border-radius: 3px;
      text-transform: uppercase;
      letter-spacing: 1px;
      transition: .3s;
    }

    .btn-gta:hover {
      background: #ff70b8;
      color: white;
      transform: translateY(-3px);
      box-shadow: 0 10px 30px rgba(255, 77, 166, .3);
    }

    .btn-outline-gta {
      border: 1px solid rgba(255,255,255,.5);
      color: white;
      font-weight: 700;
      padding: 14px 30px;
      border-radius: 3px;
      transition: .3s;
    }

    .btn-outline-gta:hover {
      background: white;
      color: black;
    }

    /* NEWS */
    .section {
      padding: 100px 0;
      background: #080808;
    }

    .section-title {
      font-size: 2.8rem;
      font-weight: 900;
      text-transform: uppercase;
      margin-bottom: 50px;
    }

    .section-title span {
      color: #ff4da6;
    }

    .news-card {
      background: #111;
      border: 1px solid #222;
      overflow: hidden;
      transition: .4s;
      height: 100%;
    }

    .news-card:hover {
      transform: translateY(-8px);
      border-color: #ff4da6;
    }

    .news-img {
      height: 220px;
      object-fit: cover;
      width: 100%;
    }

    .news-body {
      padding: 25px;
    }

    .news-body small {
      color: #ff4da6;
      font-weight: 700;
    }

    .news-body h3 {
      font-weight: 800;
      margin-top: 10px;
    }

    .news-body p {
      color: #999;
    }

    /* CHARACTERS */
    .characters {
      background: linear-gradient(135deg, #111, #050505);
    }

    .character-card {
      position: relative;
      height: 500px;
      overflow: hidden;
      background: #111;
    }

    .character-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: .5s;
    }

    .character-card:hover img {
      transform: scale(1.08);
    }

    .character-info {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 30px;
      background: linear-gradient(transparent, rgba(0,0,0,.95));
    }

    .character-info h3 {
      font-size: 2rem;
      font-weight: 900;
      margin: 0;
    }

    .character-info span {
      color: #ff4da6;
      font-weight: 700;
    }

    /* CTA */
    .cta {
      padding: 120px 0;
      text-align: center;
      background:
        linear-gradient(rgba(0,0,0,.65), rgba(0,0,0,.9)),
        url("https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?auto=format&fit=crop&w=2000&q=80")
        center/cover;
    }

    .cta h2 {
      font-size: clamp(3rem, 7vw, 6rem);
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -4px;
    }

    .cta h2 span {
      color: #ff4da6;
    }

    /* FOOTER */
    footer {
      background: #000;
      padding: 40px 0;
      color: #666;
      text-align: center;
    }

    @media (max-width: 768px) {
      .hero {
        min-height: 90vh;
      }

      .hero h1 {
        letter-spacing: -4px;
      }

      .character-card {
        height: 400px;
      }
    }
  </style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg fixed-top">
  <div class="container">
    <a class="navbar-brand" href="#">
      GTA <span>VI</span>
    </a>

    <button
      class="navbar-toggler bg-light"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link" href="#inicio">Inicio</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#historia">Historia</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#personajes">Personajes</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#noticias">Noticias</a>
        </li>
      </ul>
    </div>
  </div>
</nav>


<!-- HERO -->
<header class="hero" id="inicio">
  <div class="container">
    <div class="hero-content">

      <div class="eyebrow">
        Welcome to Vice City
      </div>

      <h1>
        Grand<br>
        Theft <span>Auto VI</span>
      </h1>

      <p>
        Bienvenido a Vice City. Una nueva generación de crimen,
        velocidad, libertad y caos te espera en el próximo capítulo
        de Grand Theft Auto.
      </p>

      <div class="d-flex gap-3 flex-wrap mt-4">
        <a href="#historia" class="btn btn-gta">
          Descubrir GTA VI
        </a>

        <a href="#noticias" class="btn btn-outline-gta">
          Ver noticias
        </a>
      </div>

    </div>
  </div>
</header>


<!-- HISTORIA -->
<section class="section" id="historia">
  <div class="container">

    <div class="section-title">
      Welcome to <span>Vice City</span>
    </div>

    <div class="row align-items-center g-5">

      <div class="col-lg-6">
        <p class="lead text-secondary">
          Vice City vuelve con una escala mucho mayor, nuevos
          personajes y una ciudad llena de oportunidades.
        </p>

        <p class="text-secondary">
          Explora playas, clubes, autopistas, barrios y zonas
          rurales mientras construyes tu propio camino en un
          mundo abierto lleno de posibilidades.
        </p>

        <button class="btn btn-gta mt-3">
          Explorar el mundo
        </button>
      </div>

      <div class="col-lg-6">
        <img
          src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=80"
          class="img-fluid"
          alt="Vice City"
        >
      </div>

    </div>
  </div>
</section>


<!-- PERSONAJES -->
<section class="section characters" id="personajes">
  <div class="container">

    <div class="section-title">
      Los <span>protagonistas</span>
    </div>

    <div class="row g-4">

      <div class="col-md-6">
        <div class="character-card">
          <img
            src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=1000&q=80"
            alt="Personaje"
          >

          <div class="character-info">
            <span>PROTAGONISTA</span>
            <h3>Lucia</h3>
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="character-card">
          <img
            src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=1000&q=80"
            alt="Personaje"
          >

          <div class="character-info">
            <span>PROTAGONISTA</span>
            <h3>Jason</h3>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- NOTICIAS -->
<section class="section" id="noticias">
  <div class="container">

    <div class="section-title">
      Últimas <span>noticias</span>
    </div>

    <div class="row g-4">

      <div class="col-md-4">
        <article class="news-card">
          <img
            class="news-img"
            src="https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=1000&q=80"
            alt="Gaming"
          >

          <div class="news-body">
            <small>GTA VI</small>
            <h3>Una nueva era comienza</h3>
            <p>
              Descubre todo lo que conocemos sobre el próximo
              capítulo de Grand Theft Auto.
            </p>
          </div>
        </article>
      </div>

      <div class="col-md-4">
        <article class="news-card">
          <img
            class="news-img"
            src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=1000&q=80"
            alt="Video games"
          >

          <div class="news-body">
            <small>VICE CITY</small>
            <h3>Explora la ciudad</h3>
            <p>
              Una ciudad viva, dinámica y llena de lugares por
              descubrir.
            </p>
          </div>
        </article>
      </div>

      <div class="col-md-4">
        <article class="news-card">
          <img
            class="news-img"
            src="https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1000&q=80"
            alt="Gaming setup"
          >

          <div class="news-body">
            <small>ROCKSTAR</small>
            <h3>El próximo gran lanzamiento</h3>
            <p>
              Prepárate para regresar a Vice City.
            </p>
          </div>
        </article>
      </div>

    </div>
  </div>
</section>


<!-- CTA -->
<section class="cta">
  <div class="container">

    <h2>
      See you in<br>
      <span>Vice City</span>
    </h2>

    <p class="text-light mb-4">
      El crimen nunca había sido tan grande.
    </p>

    <a href="#" class="btn btn-gta">
      Más información
    </a>

  </div>
</section>


<!-- FOOTER -->
<footer>
  <div class="container">
    <p class="mb-0">
      © 2026 GTA VI Fan Concept — Diseño no oficial
    </p>
  </div>
</footer>


<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
