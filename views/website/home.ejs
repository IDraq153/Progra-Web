<% layout("layouts/website") %>

<!-- =========================================================
     HERO
========================================================= -->

<section class="bg-dark text-white">

  <div
    id="heroCarousel"
    class="carousel slide carousel-fade"
    data-bs-ride="carousel"
    data-bs-interval="5000"
  >

    <!-- Indicadores -->
    <div class="carousel-indicators">

      <button
        type="button"
        data-bs-target="#heroCarousel"
        data-bs-slide-to="0"
        class="active"
        aria-current="true"
        aria-label="Slide 1">
      </button>

      <button
        type="button"
        data-bs-target="#heroCarousel"
        data-bs-slide-to="1"
        aria-label="Slide 2">
      </button>

      <button
        type="button"
        data-bs-target="#heroCarousel"
        data-bs-slide-to="2"
        aria-label="Slide 3">
      </button>

    </div>


    <!-- =====================================================
         SLIDES
    ====================================================== -->

    <div class="carousel-inner">


      <!-- =====================================================
           SLIDE 1
      ====================================================== -->

      <div class="carousel-item active">

        <div
          style="
            min-height: 650px;
            background:
              linear-gradient(
                90deg,
                rgba(5,10,8,.95) 0%,
                rgba(5,10,8,.80) 45%,
                rgba(5,10,8,.25) 100%
              ),
              url('/assets/img/slider-1.jpg')
              center/cover no-repeat;
          "
        >

          <div
            class="container d-flex align-items-center"
            style="min-height:650px;"
          >

            <div class="row w-100">

              <div class="col-lg-7 col-xl-6">

                <span class="badge bg-success px-3 py-2 mb-4">
                  <i class="bi bi-bar-chart-fill me-2"></i>
                  FIFA / EA FC PLAYER DATABASE
                </span>

                <h1 class="display-3 fw-bold lh-sm mb-4">
                  Descubre el mundo de
                  <span class="text-success">
                    PlayerStats
                  </span>
                </h1>

                <p class="lead text-light mb-4">
                  Explora jugadores, equipos, ligas,
                  posiciones y estadísticas en una
                  completa base de datos de fútbol.
                </p>

                <div class="d-flex flex-wrap gap-3">

                  <a
                    href="/players"
                    class="btn btn-success btn-lg px-4"
                  >
                    <i class="bi bi-people-fill me-2"></i>
                    Explorar jugadores
                  </a>

                  <a
                    href="#about"
                    class="btn btn-outline-light btn-lg px-4"
                  >
                    Conocer más
                  </a>

                </div>

              </div>

            </div>

          </div>

        </div>

      </div>


      <!-- =====================================================
           SLIDE 2
      ====================================================== -->

      <div class="carousel-item">

        <div
          style="
            min-height:650px;
            background:
              linear-gradient(
                90deg,
                rgba(5,10,8,.95) 0%,
                rgba(5,10,8,.80) 45%,
                rgba(5,10,8,.25) 100%
              ),
              url('/assets/img/slider-2.jpg')
              center/cover no-repeat;
          "
        >

          <div
            class="container d-flex align-items-center"
            style="min-height:650px;"
          >

            <div class="row w-100">

              <div class="col-lg-7 col-xl-6">

                <span class="badge bg-success px-3 py-2 mb-4">
                  <i class="bi bi-graph-up-arrow me-2"></i>
                  PLAYER STATISTICS
                </span>

                <h2 class="display-4 fw-bold lh-sm mb-4">
                  Analiza cada
                  <span class="text-success">
                    estadística
                  </span>
                </h2>

                <p class="lead text-light mb-4">
                  Consulta velocidad, tiro, pase, regate,
                  defensa, físico y valoración general
                  de cada jugador.
                </p>

                <a
                  href="/players"
                  class="btn btn-success btn-lg px-4"
                >
                  <i class="bi bi-bar-chart me-2"></i>
                  Ver estadísticas
                </a>

              </div>

            </div>

          </div>

        </div>

      </div>


      <!-- =====================================================
           SLIDE 3
      ====================================================== -->

      <div class="carousel-item">

        <div
          style="
            min-height:650px;
            background:
              linear-gradient(
                90deg,
                rgba(5,10,8,.95) 0%,
                rgba(5,10,8,.80) 45%,
                rgba(5,10,8,.25) 100%
              ),
              url('/assets/img/slider-3.jpg')
              center/cover no-repeat;
          "
        >

          <div
            class="container d-flex align-items-center"
            style="min-height:650px;"
          >

            <div class="row w-100">

              <div class="col-lg-7 col-xl-6">

                <span class="badge bg-success px-3 py-2 mb-4">
                  <i class="bi bi-funnel-fill me-2"></i>
                  SMART FILTERS
                </span>

                <h2 class="display-4 fw-bold lh-sm mb-4">
                  Encuentra al jugador
                  <span class="text-success">
                    perfecto
                  </span>
                </h2>

                <p class="lead text-light mb-4">
                  Filtra jugadores por posición, nación,
                  liga, equipo, pie y estilo de juego.
                </p>

                <a
                  href="/players"
                  class="btn btn-success btn-lg px-4"
                >
                  <i class="bi bi-search me-2"></i>
                  Buscar jugadores
                </a>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>


    <!-- =====================================================
         CONTROLES
    ====================================================== -->

    <button
      class="carousel-control-prev"
      type="button"
      data-bs-target="#heroCarousel"
      data-bs-slide="prev"
    >

      <span class="carousel-control-prev-icon"></span>

      <span class="visually-hidden">
        Anterior
      </span>

    </button>


    <button
      class="carousel-control-next"
      type="button"
      data-bs-target="#heroCarousel"
      data-bs-slide="next"
    >

      <span class="carousel-control-next-icon"></span>

      <span class="visually-hidden">
        Siguiente
      </span>

    </button>

  </div>

</section>


<!-- =========================================================
     BUSCADOR RÁPIDO
========================================================= -->

<section class="bg-light py-5">

  <div class="container">

    <div class="text-center mb-4">

      <span class="text-success fw-bold text-uppercase small">
        Explora la base de datos
      </span>

      <h2 class="fw-bold mt-2 mb-2">
        Encuentra tu jugador
      </h2>

      <p class="text-muted mb-0">
        Utiliza nuestros filtros para encontrar
        exactamente el jugador que buscas.
      </p>

    </div>


    <div class="card border-0 shadow-lg">

      <div class="card-body p-4 p-lg-5">

        <form
          action="/players"
          method="GET"
        >

          <div class="row g-3">


            <!-- Jugador -->

            <div class="col-12 col-lg-4">

              <label class="form-label fw-semibold">
                Jugador
              </label>

              <div class="input-group">

                <span class="input-group-text bg-white">
                  <i class="bi bi-search text-success"></i>
                </span>

                <input
                  type="text"
                  class="form-control"
                  name="search"
                  placeholder="Messi, Mbappé, Haaland..."
                >

              </div>

            </div>


            <!-- Posición -->

            <div class="col-12 col-md-4 col-lg-2">

              <label class="form-label fw-semibold">
                Posición
              </label>

              <select
                name="position"
                class="form-select"
              >

                <option value="">
                  Todas
                </option>

                <option value="GK">
                  GK
                </option>

                <option value="CB">
                  CB
                </option>

                <option value="CM">
                  CM
                </option>

                <option value="CAM">
                  CAM
                </option>

                <option value="LW">
                  LW
                </option>

                <option value="RW">
                  RW
                </option>

                <option value="ST">
                  ST
                </option>

              </select>

            </div>


            <!-- Nación -->

            <div class="col-12 col-md-4 col-lg-2">

              <label class="form-label fw-semibold">
                Nación
              </label>

              <select
                name="nation"
                class="form-select"
              >

                <option value="">
                  Todas
                </option>

                <option value="Argentina">
                  Argentina
                </option>

                <option value="Brazil">
                  Brasil
                </option>

                <option value="France">
                  Francia
                </option>

                <option value="Spain">
                  España
                </option>

              </select>

            </div>


            <!-- Liga -->

            <div class="col-12 col-md-4 col-lg-2">

              <label class="form-label fw-semibold">
                Liga
              </label>

              <select
                name="league"
                class="form-select"
              >

                <option value="">
                  Todas
                </option>

                <option value="Premier League">
                  Premier League
                </option>

                <option value="La Liga">
                  La Liga
                </option>

                <option value="Serie A">
                  Serie A
                </option>

                <option value="Bundesliga">
                  Bundesliga
                </option>

              </select>

            </div>


            <!-- Botón -->

            <div class="col-12 col-lg-2 d-flex align-items-end">

              <button
                type="submit"
                class="btn btn-success w-100 py-2"
              >

                <i class="bi bi-search me-2"></i>
                Buscar

              </button>

            </div>

          </div>

        </form>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     ESTADÍSTICAS GENERALES
========================================================= -->

<section class="py-5">

  <div class="container">

    <div class="text-center mb-5">

      <span class="text-success fw-bold text-uppercase small">
        PlayerStats
      </span>

      <h2 class="fw-bold mt-2">
        Nuestra base de datos
      </h2>

      <p class="text-muted">
        Toda la información organizada en un solo lugar.
      </p>

    </div>


    <div class="row g-4">


      <!-- Jugadores -->

      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-success bg-opacity-10
                     text-success rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-3"
              style="width:70px;height:70px;"
            >

              <i class="bi bi-people-fill fs-2"></i>

            </div>

            <h3 class="fw-bold mb-1">

              <%= typeof playerCount !== 'undefined'
                ? playerCount
                : '12K+' %>

            </h3>

            <p class="text-muted mb-0">
              Jugadores
            </p>

          </div>

        </div>

      </div>


      <!-- Equipos -->

      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-primary bg-opacity-10
                     text-primary rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-3"
              style="width:70px;height:70px;"
            >

              <i class="bi bi-shield-fill fs-2"></i>

            </div>

            <h3 class="fw-bold mb-1">

              <%= typeof teamCount !== 'undefined'
                ? teamCount
                : '500+' %>

            </h3>

            <p class="text-muted mb-0">
              Equipos
            </p>

          </div>

        </div>

      </div>


      <!-- Ligas -->

      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-warning bg-opacity-10
                     text-warning rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-3"
              style="width:70px;height:70px;"
            >

              <i class="bi bi-trophy-fill fs-2"></i>

            </div>

            <h3 class="fw-bold mb-1">

              <%= typeof leagueCount !== 'undefined'
                ? leagueCount
                : '40+' %>

            </h3>

            <p class="text-muted mb-0">
              Ligas
            </p>

          </div>

        </div>

      </div>


      <!-- Naciones -->

      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-danger bg-opacity-10
                     text-danger rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-3"
              style="width:70px;height:70px;"
            >

              <i class="bi bi-globe-americas fs-2"></i>

            </div>

            <h3 class="fw-bold mb-1">

              <%= typeof nationCount !== 'undefined'
                ? nationCount
                : '200+' %>

            </h3>

            <p class="text-muted mb-0">
              Naciones
            </p>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     EXPLORA CATEGORÍAS
========================================================= -->

<section class="bg-light py-5">

  <div class="container">

    <div class="text-center mb-5">

      <span class="text-success fw-bold text-uppercase small">
        Explora
      </span>

      <h2 class="fw-bold mt-2">
        Descubre más de PlayerStats
      </h2>

      <p class="text-muted">
        Encuentra jugadores utilizando diferentes categorías.
      </p>

    </div>


    <div class="row g-4">


      <!-- Posiciones -->

      <div class="col-12 col-md-6 col-lg-3">

        <a
          href="/players"
          class="text-decoration-none"
        >

          <div
            class="card border-0 shadow-sm h-100
                   text-center p-4"
          >

            <div
              class="bg-success bg-opacity-10
                     text-success rounded-circle
                     d-inline-flex align-items-center
