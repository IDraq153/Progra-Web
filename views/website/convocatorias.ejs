<!--views\website\convocatorias.ejs-->

<% layout("layouts/website") %>

<!-- =========================================================
     HEADER / HERO
========================================================= -->

<section class="bg-dark text-white py-5">

  <div class="container py-4">

    <div class="row align-items-center">

      <div class="col-lg-8">

        <span class="badge bg-success px-3 py-2 mb-3">
          <i class="bi bi-flag-fill me-2"></i>
          SELECCIONES NACIONALES
        </span>

        <h1 class="display-4 fw-bold mb-3">
          Convocatorias
        </h1>

        <p class="lead text-light mb-0">
          Consulta las convocatorias de jugadores de las
          principales selecciones nacionales.
        </p>

      </div>

      <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">

        <i
          class="bi bi-people-fill text-success"
          style="font-size: 7rem;"
        ></i>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     FILTROS
========================================================= -->

<section class="bg-light py-4">

  <div class="container">

    <div class="card border-0 shadow-sm">

      <div class="card-body p-4">

        <form action="/convocatorias" method="GET">

          <div class="row g-3 align-items-end">

            <!-- Buscar -->

            <div class="col-12 col-md-5">

              <label class="form-label fw-semibold">
                Buscar jugador
              </label>

              <div class="input-group">

                <span class="input-group-text bg-white">
                  <i class="bi bi-search text-success"></i>
                </span>

                <input
                  type="text"
                  name="search"
                  class="form-control"
                  placeholder="Nombre del jugador..."
                  value="<%= typeof search !== 'undefined' ? search : '' %>"
                >

              </div>

            </div>


            <!-- Selección -->

            <div class="col-12 col-md-3">

              <label class="form-label fw-semibold">
                Selección
              </label>

              <select
                name="nation"
                class="form-select"
              >

                <option value="">
                  Todas las selecciones
                </option>

                <option value="Argentina">
                  🇦🇷 Argentina
                </option>

                <option value="Brazil">
                  🇧🇷 Brasil
                </option>

                <option value="France">
                  🇫🇷 Francia
                </option>

                <option value="Spain">
                  🇪🇸 España
                </option>

                <option value="England">
                  🏴 Inglaterra
                </option>

                <option value="Germany">
                  🇩🇪 Alemania
                </option>

                <option value="Portugal">
                  🇵🇹 Portugal
                </option>

                <option value="Italy">
                  🇮🇹 Italia
                </option>

              </select>

            </div>


            <!-- Estado -->

            <div class="col-12 col-md-2">

              <label class="form-label fw-semibold">
                Estado
              </label>

              <select
                name="status"
                class="form-select"
              >

                <option value="">
                  Todos
                </option>

                <option value="convocado">
                  Convocado
                </option>

                <option value="titular">
                  Titular
                </option>

                <option value="suplente">
                  Suplente
                </option>

              </select>

            </div>


            <!-- Botón -->

            <div class="col-12 col-md-2">

              <button
                type="submit"
                class="btn btn-success w-100"
              >

                <i class="bi bi-search me-2"></i>
                Buscar

              </button>

            </div>

          </div>

        </form>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     ESTADÍSTICAS
========================================================= -->

<section class="py-4">

  <div class="container">

    <div class="row g-3">

      <!-- Convocados -->

      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body p-4">

            <div class="d-flex align-items-center">

              <div
                class="bg-success bg-opacity-10
                       text-success rounded-circle
                       d-flex align-items-center
                       justify-content-center me-3"
                style="width:55px;height:55px;"
              >

                <i class="bi bi-people-fill fs-4"></i>

              </div>

              <div>

                <h4 class="fw-bold mb-0">

                  <%= typeof convocatoriaCount !== 'undefined'
                    ? convocatoriaCount
                    : '0' %>

                </h4>

                <small class="text-muted">
                  Convocados
                </small>

              </div>

            </div>

          </div>

        </div>

      </div>


      <!-- Selecciones -->

      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body p-4">

            <div class="d-flex align-items-center">

              <div
                class="bg-primary bg-opacity-10
                       text-primary rounded-circle
                       d-flex align-items-center
                       justify-content-center me-3"
                style="width:55px;height:55px;"
              >

                <i class="bi bi-flag-fill fs-4"></i>

              </div>

              <div>

                <h4 class="fw-bold mb-0">

                  <%= typeof nationCount !== 'undefined'
                    ? nationCount
                    : '0' %>

                </h4>

                <small class="text-muted">
                  Selecciones
                </small>

              </div>

            </div>

          </div>

        </div>

      </div>


      <!-- Titulares -->

      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body p-4">

            <div class="d-flex align-items-center">

              <div
                class="bg-warning bg-opacity-10
                       text-warning rounded-circle
                       d-flex align-items-center
                       justify-content-center me-3"
                style="width:55px;height:55px;"
              >

                <i class="bi bi-person-check-fill fs-4"></i>

              </div>

              <div>

                <h4 class="fw-bold mb-0">
                  -
                </h4>

                <small class="text-muted">
                  Titulares
                </small>

              </div>

            </div>

          </div>

        </div>

      </div>


      <!-- Suplentes -->

      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body p-4">

            <div class="d-flex align-items-center">

              <div
                class="bg-info bg-opacity-10
                       text-info rounded-circle
                       d-flex align-items-center
                       justify-content-center me-3"
                style="width:55px;height:55px;"
              >

                <i class="bi bi-person-plus-fill fs-4"></i>

              </div>

              <div>

                <h4 class="fw-bold mb-0">
                  -
                </h4>

                <small class="text-muted">
                  Suplentes
                </small>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     CONVOCATORIAS
========================================================= -->

<section class="py-5 bg-light">

  <div class="container">

    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center mb-4">

      <div>

        <span class="text-success fw-bold text-uppercase small">
          Jugadores convocados
        </span>

        <h2 class="fw-bold mt-2 mb-1">
          Convocatorias
        </h2>

        <p class="text-muted mb-0">
          Lista de jugadores convocados por sus selecciones.
        </p>

      </div>

    </div>


    <!-- =====================================================
         LISTADO DINÁMICO
    ====================================================== -->

    <% if (typeof convocatorias !== 'undefined' && convocatorias.length > 0) { %>

      <div class="row g-4">

        <% convocatorias.forEach(convocatoria => { %>

          <div class="col-12 col-md-6 col-xl-4">

            <div class="card border-0 shadow-sm h-100">

              <div class="card-body p-4">

                <!-- Cabecera -->

                <div class="d-flex
                            justify-content-between
                            align-items-start mb-4">

                  <div>

                    <span class="badge bg-success">
                      Convocado
                    </span>

                  </div>

                  <i class="bi bi-flag-fill text-success fs-4"></i>

                </div>


                <!-- Jugador -->

                <div class="d-flex align-items-center mb-4">

                  <div
                    class="bg-light rounded-circle
                           d-flex align-items-center
                           justify-content-center me-3"
                    style="width:65px;height:65px;"
                  >

                    <% if (convocatoria.player && convocatoria.player.image) { %>

                      <img
                        src="<%= convocatoria.player.image %>"
                        alt="<%= convocatoria.player.name %>"
                        class="rounded-circle"
                        style="
                          width:65px;
                          height:65px;
                          object-fit:cover;
                        "
                      >

                    <% } else { %>

                      <i class="bi bi-person-fill
                                text-secondary fs-2"></i>

                    <% } %>

                  </div>


                  <div>

                    <h5 class="fw-bold mb-1">

                      <%= convocatoria.player
                        ? convocatoria.player.name
                        : (convocatoria.playerName || 'Jugador') %>

                    </h5>

                    <small class="text-muted">

                      <%= convocatoria.position
                        || convocatoria.player?.position
                        || 'Jugador' %>

                    </small>

                  </div>

                </div>


                <!-- Información -->

                <div class="border-top pt-3">

                  <div class="d-flex
                              justify-content-between
                              mb-2">

                    <span class="text-muted">
                      Selección
                    </span>

                    <span class="fw-semibold">

                      <%= convocatoria.nation
                        || convocatoria.player?.nation
                        || '—' %>

                    </span>

                  </div>


                  <div class="d-flex
                              justify-content-between
                              mb-2">

                    <span class="text-muted">
                      Equipo
                    </span>

                    <span class="fw-semibold">

                      <%= convocatoria.team
                        || convocatoria.player?.team
                        || '—' %>

                    </span>

                  </div>


                  <div class="d-flex
                              justify-content-between">

                    <span class="text-muted">
                      Estado
                    </span>

                    <span class="badge bg-success">

                      <%= convocatoria.status
                        || 'Convocado' %>

                    </span>

                  </div>

                </div>

              </div>

            </div>

          </div>

        <% }) %>

      </div>


    <% } else { %>


      <!-- =====================================================
           SIN RESULTADOS
      ====================================================== -->

      <div class="card border-0 shadow-sm">

        <div class="card-body text-center py-5">

          <div
            class="bg-success bg-opacity-10
                   text-success rounded-circle
                   d-inline-flex
                   align-items-center
                   justify-content-center mb-4"
            style="width:80px;height:80px;"
          >

            <i class="bi bi-people fs-1"></i>

          </div>

          <h4 class="fw-bold">
            No hay convocatorias disponibles
          </h4>

          <p class="text-muted mb-4">
            Actualmente no se encontraron jugadores
            convocados con los filtros seleccionados.
          </p>

          <a
            href="/convocatorias"
            class="btn btn-success"
          >

            <i class="bi bi-arrow-clockwise me-2"></i>
            Ver todas

          </a>

        </div>

      </div>

    <% } %>

  </div>

</section>


<!-- =========================================================
     INFORMACIÓN
========================================================= -->

<section class="py-5">

  <div class="container">

    <div class="row align-items-center g-5">


      <!-- Texto -->

      <div class="col-lg-6">

        <span class="badge bg-success px-3 py-2 mb-3">
          CONVOCATORIAS
        </span>

        <h2 class="fw-bold mb-4">
          Sigue a tus jugadores
          en sus selecciones.
        </h2>

        <p class="lead text-muted">
          Consulta qué jugadores forman parte de las
          diferentes convocatorias nacionales.
        </p>

        <p class="text-muted">
          Utiliza los filtros para localizar jugadores,
          consultar su selección y conocer su estado
          dentro de la convocatoria.
        </p>

        <a
          href="/players"
          class="btn btn-outline-success mt-2"
        >

          <i class="bi bi-people me-2"></i>
          Ver jugadores

        </a>

      </div>


      <!-- Características -->

      <div class="col-lg-6">

        <div class="row g-3">


          <div class="col-6">

            <div class="card border-0 shadow-sm h-100">

              <div class="card-body p-4">

                <i
                  class="bi bi-flag-fill
                         text-success fs-1"
                ></i>

                <h5 class="fw-bold mt-3">
                  Selecciones
                </h5>

                <p class="text-muted small mb-0">
                  Consulta jugadores de diferentes
                  selecciones nacionales.
                </p>

              </div>

            </div>

          </div>


          <div class="col-6">

            <div class="card border-0 shadow-sm h-100">

              <div class="card-body p-4">

                <i
                  class="bi bi-funnel-fill
                         text-success fs-1"
                ></i>

                <h5 class="fw-bold mt-3">
                  Filtros
                </h5>

                <p class="text-muted small mb-0">
                  Encuentra rápidamente al jugador
                  que estás buscando.
                </p>

              </div>

            </div>

          </div>


          <div class="col-6">

            <div class="card border-0 shadow-sm h-100">

              <div class="card-body p-4">

                <i
                  class="bi bi-person-check-fill
                         text-success fs-1"
                ></i>

                <h5 class="fw-bold mt-3">
                  Convocados
                </h5>

                <p class="text-muted small mb-0">
                  Consulta los jugadores incluidos
                  en cada convocatoria.
                </p>

              </div>

            </div>

          </div>


          <div class="col-6">

            <div class="card border-0 shadow-sm h-100">

              <div class="card-body p-4">

                <i
                  class="bi bi-database-fill
                         text-success fs-1"
                ></i>

                <h5 class="fw-bold mt-3">
                  Información
                </h5>

                <p class="text-muted small mb-0">
                  Datos organizados para facilitar
                  la consulta.
                </p>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     CTA
========================================================= -->

<section class="py-5 bg-light">

  <div class="container">

    <div
      class="bg-success rounded-4
             p-4 p-md-5
             text-center text-white
             shadow"
    >

      <i class="bi bi-flag-fill fs-1"></i>

      <h2 class="fw-bold mt-3">
        Explora todos los jugadores
      </h2>

      <p class="lead mb-4">
        Encuentra información detallada de jugadores,
        equipos, ligas y selecciones.
      </p>

      <a
        href="/players"
        class="btn btn-light btn-lg px-5"
      >

        <i class="bi bi-search me-2"></i>
        Explorar jugadores

      </a>

    </div>

  </div>

</section>
