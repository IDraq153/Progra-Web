<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Campus Pide | Locales del Campus</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="/assets/css/Home/_navbarH.css">
    <link rel="stylesheet" href="/assets/css/Home/_footerH.css">
    <link rel="stylesheet" href="/assets/css/Home/_home.css">
    <link rel="stylesheet" href="/assets/css/Home/_locales.css">
    <link rel="stylesheet" href="/assets/css/_escala.css">
</head>

<body class="escala-fluida">

    <!-- NAVBAR -->
    <%- include('partials/Home/_navbar') %>

    <!-- ENCABEZADO DE LOCALES (Mismo estilo Hero) -->
    <section class="locales-header">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Locales</li>
                </ol>
            </nav>

            <div class="row align-items-end g-3">
                <div class="col-lg-6">
                    <h1>Locales del campus</h1>
                    <p class="mb-0">
                        Selecciona tu cafetería o sanguchería favorita, revisa su carta actualizada y programa tu hora de recojo.
                    </p>
                </div>

                <div class="col-lg-6">
                    <form class="search-box ms-lg-auto" id="formBuscarLocal">
                        <input
                            type="search"
                            id="inputBuscarLocal"
                            placeholder="Buscar local o producto"
                        >
                        <button type="submit">Buscar</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="container main-content py-4">

        <!-- BARRA DE FILTROS -->
        <div class="filters-bar mb-4" id="resultados">
            <div class="filter-pills" id="filterPills">
                <button class="filter-btn active" data-filter="todos">Todos los locales</button>
                <button class="filter-btn" data-filter="abierto">Abiertos ahora</button>
            </div>

            <div class="locales-count">
                Mostrando <strong id="contadorLocales"><%= locales.length %></strong> locales disponibles
            </div>
        </div>

        <!-- GRILLA DE LOCALES -->
        <div class="row g-4" id="gridLocales">
            <% locales.forEach(local => { %>
                <div class="col-12 col-sm-6 col-lg-4 local-item" 
                     data-nombre="<%= (local.nombre + ' ' + local.ubicacion + ' ' + local.descripcion + ' ' + (local.productos || '')).toLowerCase() %>"
                     data-estado="<%= local.abierto ? 'abierto' : 'cerrado' %>">
                    
                    <a href="/locales/<%= local.id %>" class="local-card-link">
                        <div class="local-card h-100">

                            <div class="local-image position-relative">
                                <img
                                    src="<%= local.imagen %>"
                                    alt="<%= local.nombre %>"
                                    class="img-fluid"
                                >
                            </div>

                            <div class="local-info d-flex flex-column justify-content-between">
                                <div>
                                    <div class="local-name">
                                        <span><%= local.nombre %></span>
                                        <% if (local.abierto) { %>
                                            <span class="badge-open">Abierto</span>
                                        <% } else { %>
                                            <span class="badge-closed">Cerrado</span>
                                        <% } %>
                                    </div>

                                    <div class="local-description mb-2">
                                        <%= local.ubicacion %> · <%= local.horario %>
                                    </div>

                                    <p class="local-specialty mb-3">
                                        <%= local.descripcion %>
                                    </p>
                                </div>

                                <div class="local-card-footer">
                                    <span class="products-count"><%= local.calificacion ? '★ ' + local.calificacion + ' (' + local.totalCalificaciones + ')' : 'Sin calificaciones aún' %></span>
                                    <span class="action-link">Informacion del local →</span>
                                </div>
                            </div>

                        </div>
                    </a>

                </div>
            <% }) %>
        </div>

        <!-- MENSAJE SI NO HAY RESULTADOS EN BÚSQUEDA -->
        <div id="sinResultados" class="empty-state text-center d-none">
            <h4>No encontramos locales con ese criterio</h4>
            <p>Prueba con otro local o producto, o muestra todos los locales.</p>
            <button class="btn cta-button" id="btnResetFiltros">Ver todos los locales</button>
        </div>

    </main>

    <!-- FOOTER -->
    <%- include('partials/Home/_footer') %>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Script para filtrar y buscar en tiempo real -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const inputBuscar = document.getElementById('inputBuscarLocal');
            const filterBtns = document.querySelectorAll('.filter-btn');
            const items = document.querySelectorAll('.local-item');
            const contador = document.getElementById('contadorLocales');
            const sinResultados = document.getElementById('sinResultados');
            const btnReset = document.getElementById('btnResetFiltros');

            let filtroActual = 'todos';

            // Ignora mayúsculas y tildes: «sandwich» encuentra «Sándwich»
            const normalizar = (t) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

            // En celular los resultados quedan debajo: se cierra el teclado y se baja hasta ellos
            function mostrarResultados() {
                inputBuscar.blur();
                const destino = document.getElementById('resultados');
                const alto = document.querySelector('.navbar').offsetHeight;
                window.scrollTo({ top: destino.getBoundingClientRect().top + window.scrollY - alto - 12, behavior: 'smooth' });
            }

            function filtrarLocales() {
                const texto = normalizar(inputBuscar.value);
                let visibles = 0;

                items.forEach(item => {
                    const nombre = normalizar(item.dataset.nombre);
                    const estado = item.dataset.estado;

                    const coincideTexto = nombre.includes(texto);
                    const coincideFiltro = filtroActual === 'todos' || estado === 'abierto';

                    if (coincideTexto && coincideFiltro) {
                        item.classList.remove('d-none');
                        visibles++;
                    } else {
                        item.classList.add('d-none');
                    }
                });

                contador.textContent = visibles;
                sinResultados.classList.toggle('d-none', visibles > 0);
            }

            inputBuscar.addEventListener('input', filtrarLocales);

            document.getElementById('formBuscarLocal').addEventListener('submit', (e) => {
                e.preventDefault();
                filtrarLocales();
                mostrarResultados();
            });

            // Viene del buscador del home: /locales?q=texto
            const q = new URLSearchParams(window.location.search).get('q');
            if (q) {
                inputBuscar.value = q;
                filtrarLocales();
                mostrarResultados();
            }

            filterBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    filterBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    filtroActual = btn.dataset.filter;
                    filtrarLocales();
                });
            });

            btnReset.addEventListener('click', () => {
                inputBuscar.value = '';
                filterBtns[0].click();
            });
        });
    </script>
</body>
</html>