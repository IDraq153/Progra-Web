<%_
    // Todo viene de la base de datos (website/controllers.js -> detalleLocal)
    const local = localData;
    const estaAbierto = local.abierto === true;
    const cal = calificaciones || { summary: { average: null, total: 0, distribution: {} }, reviews: [] };
    const estrellas = (n) => '★'.repeat(n) + '☆'.repeat(5 - n);
    const textoCalificacion = cal.summary.total
        ? `★ ${cal.summary.average} (${cal.summary.total})`
        : 'Sin calificaciones aún';
_%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campus Pide | <%= local.nombre %></title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/Home/_navbarH.css">
    <link rel="stylesheet" href="/assets/css/Home/_footerH.css">
    <link rel="stylesheet" href="/assets/css/Home/_home.css">
    <link rel="stylesheet" href="/assets/css/_escala.css">

    <style>
        body.lc-body { --lc-red: #d93829; --lc-red-dark: #c32f21; --lc-border: #ece7e5; --lc-muted: #6a6462; background-color: #fcfaf9; color: #252525; }

        .lc-page { max-width: 46rem; padding-top: 1rem; padding-bottom: 3rem; }
        .lc-back { display: inline-block; margin-bottom: 1rem; color: var(--lc-red); font-size: .92rem; font-weight: 600; text-decoration: none; }

        .lc-media img { display: block; width: 100%; height: 18rem; object-fit: cover; border-radius: 1rem; }
        .lc-cerrado .lc-media img { filter: grayscale(.85); opacity: .88; }

        .lc-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: .75rem; margin-top: 1.25rem; }
        .local-main-title { margin: 0; font-size: clamp(1.6rem, 5vw, 2.25rem); font-weight: 800; line-height: 1.2; }
        .lc-pill { flex: none; margin-top: .35rem; padding: .3rem .75rem; border-radius: 3.125rem; font-size: .78rem; font-weight: 700; }
        .lc-pill.open { background: #e4f4df; color: #34762c; }
        .lc-pill.closed { background: #ece9e8; color: #6c6260; }
        .local-intro { margin: .6rem 0 0; color: var(--lc-muted); line-height: 1.6; }

        .lc-facts { list-style: none; margin: 1.25rem 0; padding: 0; border-top: 1px solid var(--lc-border); }
        .lc-facts li { display: flex; justify-content: space-between; gap: 1rem; padding: .75rem 0; border-bottom: 1px solid var(--lc-border); font-size: .95rem; }
        .lc-facts span { color: var(--lc-muted); }
        .lc-facts strong { text-align: right; }

        .lc-btn { display: block; width: 100%; padding: .75rem 1.3rem; border: 1px solid var(--lc-red); border-radius: .7rem; font-size: .95rem; font-weight: 700; text-align: center; text-decoration: none; }
        .lc-btn-primary { background: var(--lc-red); color: #fff; }
        .lc-btn-primary:hover { background: var(--lc-red-dark); color: #fff; }
        .lc-btn-ghost { background: #fff; color: var(--lc-red); }

        .lc-reviews { margin-top: 2.5rem; }
        .lc-reviews h2 { margin-bottom: 1rem; font-size: 1.25rem; font-weight: 800; }
        .lc-reviews-empty { color: var(--lc-muted); }
        .lc-ver-todas { margin-top: .75rem; }

        /* ---- Calificaciones ---- */
        .lc-card { padding: 1.1rem; background: #fff; border: 1px solid var(--lc-border); border-radius: 1rem; }
        .lc-modal-body { display: flex; flex-direction: column; gap: .75rem; background: #faf8f7; }
        .lc-review { margin: 0; overflow-wrap: anywhere; word-break: break-word; }
        .lc-review-head { display: flex; align-items: center; gap: .7rem; }
        .lc-review-avatar { width: 36px; height: 36px; flex: none; border-radius: 50%; background: #FCEAE7; display: grid; place-items: center; font-weight: 700; }
        .lc-review-who { flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.2; }
        .lc-review-who small { color: #6b7280; }
        .lc-review-stars { color: #f5a623; white-space: nowrap; }
        .lc-review-text { margin: .7rem 0 0; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
        .lc-review-products { list-style: none; margin: .7rem 0 0; padding: .6rem 0 0; border-top: 1px solid #eee; font-size: .85rem; }
        .lc-review-products li { display: flex; flex-wrap: wrap; gap: .2rem .6rem; padding: 2px 0; }
        .lc-review-prod-name { font-weight: 600; }
        .lc-review-prod-stars { color: #f5a623; }
        .lc-review-products em { flex-basis: 100%; color: #6b7280; }
        .lc-review-more, .lc-reviews-more { color: #6b7280; font-size: .8rem; }
        .lc-review-reply { margin-top: .7rem; padding: .6rem .8rem; background: #FCEAE7; border-radius: 8px; font-size: .85rem; }
        .lc-reviews-more { text-align: center; margin: .25rem 0 0; }

        /* ---------- Celular: vista limpia (en PC no cambia) ---------- */
        @media (max-width: 767.98px) {
            .local-kicker,
            .lc-hero .lc-btn-ghost,
            .status-note,
            .lc-media-place,
            .local-info-section > section:first-child,
            .local-info-section .row > .col-lg-4,
            .section-heading .eyebrow,
            .lc-cta { display: none; }

            .lc-hero { padding: 1rem 0 1.25rem; background: none; border-bottom: 0; }
            .breadcrumb-custom { margin-bottom: 1rem; }
            .breadcrumb-custom span { display: none; }
            .lc-hero .row > .col-lg-6:last-child { order: -1; }
            .lc-media { box-shadow: none; }
            .lc-media::after { content: none; }
            .local-intro { margin: .6rem 0 1rem; line-height: 1.6; }
            .lc-hero .lc-btn { width: 100%; justify-content: center; }

            .lc-facts { margin-top: 0; }
            .lc-facts-card { box-shadow: none; }
            .lc-fact { padding: .75rem 1rem; justify-content: space-between; }
            .lc-fact-icon { display: none; }
            .lc-fact > div:last-child { display: flex; flex: 1; justify-content: space-between; gap: 1rem; text-align: right; }
            .lc-fact small { text-transform: none; letter-spacing: 0; font-size: .9rem; font-weight: 400; margin: 0; }

            .local-info-section { padding: 1.75rem .75rem 2.5rem; }
            .local-info-section > section { margin-bottom: 0 !important; }
            .section-heading h2 { font-size: 1.25rem; }
            .lc-ver-todas { align-self: stretch; justify-content: center; }
        }
    </style>
</head>
<body class="escala-fluida lc-body">

    <!-- NAVBAR -->
    <%- include('../partials/Home/_navbar') %>

    <main class="container lc-page <%= estaAbierto ? '' : 'lc-cerrado' %>">
        <a href="/locales" class="lc-back">← Todos los locales</a>

        <div class="lc-media">
            <img src="<%= local.imagen %>" alt="Imagen de <%= local.nombre %>">
        </div>

        <div class="lc-title-row">
            <h1 class="local-main-title"><%= local.nombre %></h1>
            <span class="lc-pill <%= estaAbierto ? 'open' : 'closed' %>"><%= estaAbierto ? 'Abierto' : 'Cerrado' %></span>
        </div>
        <p class="local-intro"><%= local.descripcion %></p>

        <ul class="lc-facts">
            <li><span>Ubicación</span><strong><%= local.ubicacion %></strong></li>
            <li><span>Campus</span><strong><%= local.campus %></strong></li>
            <li><span>Horario</span><strong><%= local.horario %></strong></li>
            <li><span>Calificación</span><strong><%= textoCalificacion %></strong></li>
        </ul>

        <a href="/register" class="lc-btn lc-btn-primary">Crear cuenta para pedir</a>

        <!-- CALIFICACIONES -->
        <section class="lc-reviews">
            <h2>Última calificación</h2>

            <% if (cal.summary.total === 0) { %>
                <p class="lc-reviews-empty">Este local aún no tiene calificaciones.</p>
            <% } else { %>
                <% [cal.reviews[0]].forEach(function (r) { %>
<article class="lc-card lc-review">
                                <div class="lc-review-head">
                                    <div class="lc-review-avatar"><%= r.author.charAt(0) %></div>
                                    <div class="lc-review-who">
                                        <strong><%= r.author %></strong>
                                        <small><%= r.date %></small>
                                    </div>
                                    <span class="lc-review-stars"><%= estrellas(r.rating) %></span>
                                </div>
                                <% if (r.comment) { %><p class="lc-review-text"><%= r.comment %></p><% } %>
                                <% if (r.products.length) { %>
                                    <ul class="lc-review-products">
                                        <% r.products.slice(0, 3).forEach(function (pr) { %>
                                            <li>
                                                <span class="lc-review-prod-name"><%= pr.name %></span>
                                                <span class="lc-review-prod-stars"><%= estrellas(pr.rating) %></span>
                                                <% if (pr.comment) { %><em><%= pr.comment %></em><% } %>
                                            </li>
                                        <% }); %>
                                        <% if (r.products.length > 3) { %><li class="lc-review-more">+<%= r.products.length - 3 %> productos más</li><% } %>
                                    </ul>
                                <% } %>
                                <% if (r.reply) { %><div class="lc-review-reply"><strong>Respuesta del local:</strong> <%= r.reply %></div><% } %>
                            </article>
                                                        <% }); %>
                <button type="button" class="lc-btn lc-btn-ghost lc-ver-todas" data-bs-toggle="modal" data-bs-target="#modalCalificaciones">
                    Ver todas (<%= cal.summary.total %>)
                </button>
            <% } %>
        </section>
    </main>

    <% if (cal.summary.total > 0) { %>
    <!-- VENTANA FLOTANTE DE CALIFICACIONES -->
    <div class="modal fade" id="modalCalificaciones" tabindex="-1" aria-labelledby="tituloCalificaciones" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="tituloCalificaciones">Calificaciones de <%= local.nombre %></h5>
                        <small class="text-muted">★ <%= cal.summary.average %> · <%= cal.summary.total %> <%= cal.summary.total === 1 ? 'calificación' : 'calificaciones' %></small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body lc-modal-body">
                    <% cal.reviews.forEach(function (r) { %>
<article class="lc-card lc-review">
                        <div class="lc-review-head">
                            <div class="lc-review-avatar"><%= r.author.charAt(0) %></div>
                            <div class="lc-review-who">
                                <strong><%= r.author %></strong>
                                <small><%= r.date %></small>
                            </div>
                            <span class="lc-review-stars"><%= estrellas(r.rating) %></span>
                        </div>
                        <% if (r.comment) { %><p class="lc-review-text"><%= r.comment %></p><% } %>
                        <% if (r.products.length) { %>
                            <ul class="lc-review-products">
                                <% r.products.slice(0, 3).forEach(function (pr) { %>
                                    <li>
                                        <span class="lc-review-prod-name"><%= pr.name %></span>
                                        <span class="lc-review-prod-stars"><%= estrellas(pr.rating) %></span>
                                        <% if (pr.comment) { %><em><%= pr.comment %></em><% } %>
                                    </li>
                                <% }); %>
                                <% if (r.products.length > 3) { %><li class="lc-review-more">+<%= r.products.length - 3 %> productos más</li><% } %>
                            </ul>
                        <% } %>
                        <% if (r.reply) { %><div class="lc-review-reply"><strong>Respuesta del local:</strong> <%= r.reply %></div><% } %>
                    </article>
                                        <% }); %>
                    <% if (cal.summary.total > cal.reviews.length) { %>
                        <p class="lc-reviews-more">Mostrando las <%= cal.reviews.length %> más recientes de <%= cal.summary.total %> calificaciones.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <!-- FOOTER -->
    <%- include('../partials/Home/_footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
